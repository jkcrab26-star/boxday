VITE_ANTHROPIC_API_KEY=
VITE_STRIPE_MONTHLY_LINK=https://buy.stripe.com/your-monthly-link
VITE_STRIPE_ANNUAL_LINK=https://buy.stripe.com/your-annual-link

# Google Calendar OAuth (public client ID — safe to expose)
# Create at: https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID (Web application)
# Authorized JS origins: http://localhost:5173, https://your-deployed-domain.com
# Scopes required: https://www.googleapis.com/auth/calendar.events
VITE_GOOGLE_CLIENT_ID=

# Waitlist landing page
# Create a free form at https://formspree.io and paste the form ID here
VITE_FORMSPREE_ID=your-formspree-form-id
# Set to "app" to show the full app instead of the waitlist page (for local dev)
VITE_APP_MODE=app
